# Copier ce fichier en .env.local et renseigner les valeurs. .env.local n'est jamais commité.

# Chaîne de connexion Postgres (Neon, point d'accès « pooler »).
DATABASE_URL=""

# Chaîne de connexion de la base de test (branche Neon « test »), distincte de DATABASE_URL.
# Utilisée par `pnpm db:migrate:test`, `pnpm test:integration` et `pnpm test:e2e`.
# Si elle manque, ces commandes échouent : elles ne se rabattent jamais sur DATABASE_URL.
DATABASE_URL_TEST=""

# Secret de Better Auth : signe le cookie de session. Au moins 32 caractères aléatoires,
# par exemple avec `openssl rand -base64 48`. Le changer déconnecte tout le monde.
BETTER_AUTH_SECRET=""

# Adresse publique de l'application, sans chemin. En développement : http://localhost:3000
# (`pnpm test:e2e` la remplace par http://localhost:3100 pour son propre serveur).
# En https, le cookie de session est marqué Secure.
BETTER_AUTH_URL=""

# Envoi des e-mails (spécification 05).
# Transport choisi : « local » n'envoie rien, il range chaque message dans la table
# local_email (relisible avec `pnpm email:export`). Absent ou inconnu : l'envoi est
# « non configuré » et l'application propose seulement de télécharger la quittance.
EMAIL_TRANSPORT="local"

# Adresse d'expédition de l'application (nom affiché : « Quittances »). Le locataire
# qui répond écrit à l'adresse du compte du propriétaire, jamais à celle-ci.
EMAIL_FROM_ADDRESS="quittances@exemple.test"

# À renseigner (par exemple « true ») sur l'environnement de PRODUCTION RÉELLE seulement.
# Tant qu'il est défini, le transport local refuse d'envoyer : il n'enverrait rien, et
# ne doit pas le laisser croire. Absente par défaut, y compris pour le build servi
# par `pnpm test:e2e`, qui garde le transport local.
REAL_PRODUCTION=""
